rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidLedgerWorkspace(data) {
      return data.keys().hasAll(['ownerId', 'ownerEmail', 'payload', 'version', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'ownerEmail', 'payload', 'version', 'createdAt', 'updatedAt'])
        && data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.ownerId == request.auth.uid
        && data.ownerEmail is string && data.ownerEmail.size() >= 3 && data.ownerEmail.size() <= 256
        && data.payload is string && data.payload.size() >= 2 && data.payload.size() <= 950000
        && data.version is number
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /ledgers/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow create: if isVerified()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidLedgerWorkspace(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerified()
        && isValidId(userId)
        && isValidLedgerWorkspace(incoming())
        && request.auth.uid == userId
        && existing().ownerId == request.auth.uid
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['payload', 'version', 'updatedAt', 'ownerEmail']);
      allow delete: if isVerified()
        && isValidId(userId)
        && request.auth.uid == userId
        && existing().ownerId == request.auth.uid;
    }
  }
}
